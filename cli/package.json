{
  "name": "@yaco/cli",
  "version": "0.1.0",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "description": "YACO command-line interface — the yaco dispatcher for agent sessions, task graphs, worktrees, and project paths.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imoonkey/yaco.git",
    "directory": "cli"
  },
  "bin": {
    "yaco": "./src/main.ts"
  },
  "exports": {
    "./core/paths": "./src/lib/core/paths/index.ts",
    "./core/result": "./src/lib/core/result.ts",
    "./core/errors": "./src/lib/core/errors.ts",
    "./core/task": "./src/lib/core/task/index.ts",
    "./core/agent": "./src/lib/core/agent/index.ts",
    "./core/worktree": "./src/lib/core/worktree/index.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun run test:unit",
    "test:unit": "node test/cohorts.mjs unit",
    "reinstall": "../tools/install.sh --cli-only",
    "test:integration": "bun run reinstall && node test/cohorts.mjs integration",
    "test:all": "bun run test:unit && bun run test:integration",
    "build": "bun build src/main.ts --compile --outfile yaco"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "smol-toml": "^1.7.1"
  }
}
