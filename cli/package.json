{
  "name": "yaco-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "YACO command-line interface — the yaco dispatcher for agent sessions, task graphs, worktrees, and project paths.",
  "keywords": [
    "yaco",
    "coding-agent",
    "agent-orchestration",
    "claude-code",
    "codex",
    "tmux",
    "task-graph",
    "git-worktree",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://github.com/imoonkey/yaco#readme",
  "bugs": {
    "url": "https://github.com/imoonkey/yaco/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imoonkey/yaco.git",
    "directory": "cli"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "yaco": "./bin/yaco.mjs"
  },
  "exports": {
    "./core/paths": {
      "development": "./src/lib/core/paths/index.ts",
      "types": "./dist/lib/core/paths/index.d.ts",
      "default": "./dist/lib/core/paths/index.js"
    },
    "./core/result": {
      "development": "./src/lib/core/result.ts",
      "types": "./dist/lib/core/result.d.ts",
      "default": "./dist/lib/core/result.js"
    },
    "./core/errors": {
      "development": "./src/lib/core/errors.ts",
      "types": "./dist/lib/core/errors.d.ts",
      "default": "./dist/lib/core/errors.js"
    },
    "./core/task": {
      "development": "./src/lib/core/task/index.ts",
      "types": "./dist/lib/core/task/index.d.ts",
      "default": "./dist/lib/core/task/index.js"
    },
    "./core/agent": {
      "development": "./src/lib/core/agent/index.ts",
      "types": "./dist/lib/core/agent/index.d.ts",
      "default": "./dist/lib/core/agent/index.js"
    },
    "./core/agent/messages": {
      "development": "./src/lib/core/agent/providers/message-read.ts",
      "types": "./dist/lib/core/agent/providers/message-read.d.ts",
      "default": "./dist/lib/core/agent/providers/message-read.js"
    },
    "./core/agent/summaries": {
      "development": "./src/lib/core/agent/providers/summary-read.ts",
      "types": "./dist/lib/core/agent/providers/summary-read.d.ts",
      "default": "./dist/lib/core/agent/providers/summary-read.js"
    },
    "./core/worktree": {
      "development": "./src/lib/core/worktree/index.ts",
      "types": "./dist/lib/core/worktree/index.d.ts",
      "default": "./dist/lib/core/worktree/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "agent-config",
    "scripts/agent-wrapper.sh",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist agent-config",
    "build": "npm run build:assets && npm run build:bundle && npm run build:lib",
    "build:assets": "node scripts/sync-agent-config.mjs",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/yaco.mjs",
    "build:lib": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "reinstall": "../tools/install.sh --cli-only",
    "test:integration": "npm run reinstall && vitest run --project integration",
    "test:pack": "vitest run --project integration test/integration/pack.test.ts",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "smol-toml": "^1.7.1"
  }
}
